# Database Configuration (MongoDB Atlas exclusively)
# Cloud Database (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster.mongodb.net/medimind_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/medimind_db?retryWrites=true&w=majority
DATABASE_NAME=medimind_db

# Security & Authentication Secrets (REQUIRED - App will abort startup if unconfigured)
JWT_SECRET=your_super_secret_random_64_character_hex_key_here

# Initial Admin Credentials (REQUIRED - App will abort startup if unconfigured)
ADMIN_EMAIL=admin@medimind.ai
ADMIN_PASSWORD=your_secure_admin_password_here

# CORS Allowed Origins (Comma-separated URLs or wildcard *)
# In production on Render: Set this to your Vercel URL, e.g.:
# CORS_ORIGINS=https://medimind-ai.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM API Keys (Groq or OpenAI)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=openai/gpt-oss-120b
