# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=medimind_db

# Security & Authentication Secrets (REQUIRED - App will raise RuntimeError if empty)
JWT_SECRET=your_jwt_secret_key_here

# Hardened Admin Credentials (REQUIRED - App will raise RuntimeError if empty)
ADMIN_EMAIL=admin@medimind.ai
ADMIN_PASSWORD=your_secure_admin_password_here

# CORS Allowed Origins (Comma-separated URLs, NO wildcard *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=openai/gpt-oss-120b
